# =============================================================================
# Helixa - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Required variables are marked with [REQUIRED], optional with [OPTIONAL].
# =============================================================================

# --- Supabase ---
# [REQUIRED] Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# [REQUIRED] Your Supabase anonymous/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# [REQUIRED] Your Supabase service role key (server-side only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- AI / LLM Providers ---
# [REQUIRED] Groq API key for AI features (auto-reply, analytics, copy suggestions, etc.)
# Get one free at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
# [OPTIONAL] Gemini API key (fallback provider for AI features)
GEMINI_API_KEY=your_gemini_api_key
# [OPTIONAL] OpenRouter API key (secondary fallback for AI features)
OPENROUTER_API_KEY=your_openrouter_api_key

# --- Instagram / Meta ---
# [REQUIRED] Instagram/Meta App ID (from Meta Developer Dashboard)
NEXT_PUBLIC_INSTAGRAM_APP_ID=your_instagram_app_id
# [REQUIRED] Instagram/Meta App Secret
INSTAGRAM_APP_SECRET=your_instagram_app_secret
# [OPTIONAL] Legacy alias for app secret (falls back to INSTAGRAM_APP_SECRET)
META_APP_SECRET=
# [OPTIONAL] Custom Instagram redirect URI (defaults to {APP_URL}/api/instagram/callback)
NEXT_PUBLIC_INSTAGRAM_REDIRECT_URI=
# [OPTIONAL] Instagram webhook verify token
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# --- Facebook ---
# [OPTIONAL] Facebook App ID (falls back to INSTAGRAM_APP_ID)
NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id
# [OPTIONAL] Facebook App Secret (falls back to META_APP_SECRET)
FACEBOOK_APP_SECRET=your_facebook_app_secret
# [OPTIONAL] Facebook redirect URI (defaults to {APP_URL}/api/facebook/callback)
NEXT_PUBLIC_FACEBOOK_REDIRECT_URI=
# [OPTIONAL] Facebook webhook verify token
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your_facebook_webhook_verify_token

# --- WhatsApp ---
# [OPTIONAL] WhatsApp webhook verify token (falls back to INSTAGRAM_WEBHOOK_VERIFY_TOKEN)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_whatsapp_webhook_verify_token

# --- Telegram ---
# (No env vars needed — bots are configured per-account in the database)

# --- Stripe ---
# [OPTIONAL] Stripe secret key (for payments — https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
# [OPTIONAL] Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
# [OPTIONAL] Stripe price IDs for subscriptions
STRIPE_MONTHLY_PRICE_ID=price_your_monthly_price_id
STRIPE_ONE_TIME_PRICE_ID=price_your_one_time_price_id

# --- App ---
# [REQUIRED] Your production app URL (used for OAuth redirects, webhooks, etc.)
NEXT_PUBLIC_APP_URL=https://helixa-main-ecru.vercel.app

# --- Security ---
# [OPTIONAL] Secret for encrypting BYOK (Bring Your Own Key) API keys
BYOK_ENCRYPTION_SECRET=your_byok_encryption_secret
# [OPTIONAL] Disable webhook signature verification (ONLY for local dev — never in production)
DISABLE_WEBHOOK_SIGNATURE_CHECK=false

# --- IP Quality Score ---
# [OPTIONAL] IPQS API key for fraud detection during Instagram connection
IPQS_API_KEY=your_ipqs_api_key

# --- Cron ---
# [OPTIONAL] Secret for securing cron job endpoints
CRON_SECRET=your_cron_secret
