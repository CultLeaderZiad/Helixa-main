# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Instagram / Meta App
# This app uses "Instagram API with Instagram Login" (Business Login) — NOT Instagram
# Basic Display and NOT Facebook Login. Dashboard: https://developers.facebook.com/apps/
#   -> Your App -> Instagram -> API setup with Instagram business login
#
# App ID / secret: use the *Instagram app ID* and *Instagram app secret* shown on that
# Instagram product page — NOT the parent Meta app ID from Settings -> Basic.
NEXT_PUBLIC_INSTAGRAM_APP_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional: parent Meta app secret (Settings -> Basic). Only needed if webhook signature
# validation fails with 401s because Meta signs deliveries with the parent app secret.
META_APP_SECRET=
# Must exactly match one of the "OAuth redirect URIs" in Instagram -> Business login settings
# (character-for-character: scheme, host, path, no trailing slash mismatch).
NEXT_PUBLIC_INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
# Any random string; enter the same value in the webhook subscription form in the dashboard.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# App URL (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — https://dashboard.stripe.com/apikeys
# Use test-mode keys (prefix sk_test_) for local development
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create products in Stripe and paste the Price IDs here
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ONE_TIME_PRICE_ID=

# AI Agents & LLMs
# Secret string used to symmetrically encrypt customer API keys (BYOK) in the database via pgcrypto.
# Must be consistent and never changed after keys are stored, otherwise existing keys become unreadable.
BYOK_ENCRYPTION_SECRET=

# Groq is the primary provider for text-based analysis (e.g., FAQ detection, comment themes)
GROQ_API_KEY=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

# OpenRouter acts as the automatic fallback provider when Groq hits rate limits or is down
OPENROUTER_API_KEY=

# Gemini is the primary provider for multimodal agents (e.g., hook strength checker evaluating reels/images)
GEMINI_API_KEY=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_FROM_NAME="Helixa"
MAILGUN_REPLY_TO=
